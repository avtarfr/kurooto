<?xml version="1.0" encoding="utf-8"?>
<!-- the 1x1 Talk widget (TalkWidget): one round button that opens the chat ready to type -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@+id/talk"
        android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center"
        android:background="@drawable/k_widget_talk" android:contentDescription="@string/widget_talk">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
            android:src="@drawable/ic_talk" android:tint="@color/k_on_primary_container"
            android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
