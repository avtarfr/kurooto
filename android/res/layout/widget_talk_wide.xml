<?xml version="1.0" encoding="utf-8"?>
<!-- the 2x1 widget (TalkWideWidget): the Talk button, and what's waiting for you (tap it for the app) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"
    android:background="@drawable/k_widget" android:padding="8dp">
    <FrameLayout android:id="@+id/talk"
        android:layout_width="48dp" android:layout_height="48dp"
        android:background="@drawable/k_widget_talk" android:contentDescription="@string/widget_talk">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
            android:src="@drawable/ic_talk" android:tint="@color/k_on_primary_container"
            android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:id="@+id/info"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/k_fg"
            android:maxLines="1" android:ellipsize="end" android:text="Kurooto" />
        <TextView android:id="@+id/line"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/k_dim"
            android:maxLines="2" android:ellipsize="end" android:text="@string/widget_nothing" />
    </LinearLayout>
</LinearLayout>
