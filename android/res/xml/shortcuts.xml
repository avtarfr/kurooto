<?xml version="1.0" encoding="utf-8"?>
<!-- the launcher's long-press menu (Android 7.1+; older launchers ignore this file): Quick note -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="note"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_note"
        android:shortcutShortLabel="@string/note_short"
        android:shortcutLongLabel="@string/note_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.avtarfr.kurooto"
            android:targetClass="io.github.avtarfr.kurooto.QuickNoteActivity" />
    </shortcut>
</shortcuts>
