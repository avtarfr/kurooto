<?xml version="1.0" encoding="utf-8"?>
<!-- a Material 3 dialog: 28dp corners on the card colour, kept clear of the screen's edges -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp" android:insetRight="16dp" android:insetTop="24dp" android:insetBottom="24dp">
    <shape android:shape="rectangle">
        <corners android:radius="28dp" />
        <solid android:color="@color/k_card" />
    </shape>
</inset>
