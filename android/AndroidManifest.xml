<?xml version="1.0" encoding="utf-8"?>
<!-- Kurooto for Android: rings like a phone call when Kurooto calls you (reminders, check-ins, the wake-up alarm),
     runs the call itself (earpiece, screen off at your ear; or turn by turn with the phone's own speech), shows its questions and approvals with a Reply box and
     answer buttons, chats with it like Telegram, shows your day (Today) and rings your wake-up alarm on the phone too,
     shares files and quick notes to your notes (a home screen widget, a launcher shortcut, a Quick Settings tile), and
     turns an old phone into a bedside dock (a dim clock with one button to talk). Works from Android 6.
     Paired with your own call line by a one-time link from your computer; nothing personal is built into the app.
     Gradle (build.gradle.kts) sets the package, the SDK levels and the app's label (the appLabel placeholder: "Kurooto", or "Kurooto dev"). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- location reminders (Places, off by default): asked for only when you turn them on in the app -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- the wake-up alarm, also set on the phone (Alarms): exact alarms on Android 12 (the phone may ask), and the
         alarm-clock permission from Android 13, which comes with the app -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- turn-by-turn calls use the phone's own speech recognizer and voice: Android 11+ only lets the app see them
         when it says so here -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application
        android:name=".App"
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Kurooto"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">

        <!-- the main screen (Compose): Today, Inbox and Phone under a navigation bar, or pairing; the predictive back
             gesture (Android 14+; ignored before) -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- long-press the app's icon: Quick note (Android 7.1+) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- kurooto://pair?c=CODE&u=https://your-line : the pairing page's "Pair the app" button -->
        <activity android:name=".PairActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Kurooto.Sheet">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kurooto" android:host="pair" />
            </intent-filter>
        </activity>

        <activity android:name=".CallActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Kurooto.Call"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- bedside mode: a dock clock with one button to talk, over the lock screen (BedsideActivity) -->
        <activity android:name=".BedsideActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:launchMode="singleTop"
            android:theme="@style/Kurooto.Call" />

        <!-- a question, approval or message, with every way to answer it (tapping its notification) -->
        <activity android:name=".AnswerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Kurooto.Sheet" />

        <!-- Systems and the Notes map: the dashboard's drawings in a shut-in WebView (ViewsActivity) -->
        <activity android:name=".ViewsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- the chat with Kurooto, beside Telegram -->
        <activity android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".ShareActivity"
            android:exported="true"
            android:label="${appLabel}"
            android:excludeFromRecents="true"
            android:theme="@style/Kurooto.Sheet">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Quick note: a small box whose note goes to your notes inbox (the launcher shortcut and the tile). Exported
             only so every launcher can open the shortcut; it sends nothing unless you type a note and tap Save. -->
        <activity android:name=".QuickNoteActivity"
            android:exported="true"
            android:label="@string/note_short"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="stateVisible|adjustResize"
            android:theme="@style/Kurooto.Sheet" />

        <!-- the Quick Settings tile "Quick note" (Android 7+) -->
        <service android:name=".NoteTile"
            android:exported="true"
            android:label="@string/note_short"
            android:icon="@drawable/ic_note"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- home screen widgets: Talk (1x1) and Talk, and what's waiting (2x1) -->
        <receiver android:name=".TalkWidget" android:exported="true" android:label="@string/widget_talk">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_talk" />
        </receiver>
        <receiver android:name=".TalkWideWidget" android:exported="true" android:label="@string/widget_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_talk_wide" />
        </receiver>

        <service android:name=".ListenService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".ActionReceiver" android:exported="false" />

        <!-- location reminders: your saved places, and Android's alert when you reach one -->
        <activity android:name=".PlacesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <receiver android:name=".PlaceReceiver" android:exported="false" />
    </application>
</manifest>
